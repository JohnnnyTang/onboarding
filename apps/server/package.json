{
  "name": "@bgp/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.build.json && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "dev": "tsx watch ../../scripts/scaffold-dev.ts @bgp/server",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bgp/rules-host": "workspace:*",
    "@bgp/schema": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
