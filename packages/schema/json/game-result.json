{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "winners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "scores": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "reason": {
      "type": "string"
    }
  },
  "required": ["winners"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "title": "GameResult"
}
