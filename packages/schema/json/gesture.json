{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "click"
        },
        "item": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["kind", "item"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "clickZone"
        },
        "zone": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["kind", "zone"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "drop"
        },
        "item": {
          "$ref": "#/$defs/__schema0"
        },
        "from": {
          "$ref": "#/$defs/__schema0"
        },
        "to": {
          "$ref": "#/$defs/__schema0"
        },
        "index": {
          "minimum": 0,
          "$ref": "#/$defs/__schema1"
        },
        "pos_mm": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema1"
            },
            {
              "$ref": "#/$defs/__schema1"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["kind", "item", "from", "to"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "title": "Gesture"
}
