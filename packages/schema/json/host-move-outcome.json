{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "event": {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "seat": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "intent": {
              "type": "object",
              "properties": {
                "move": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "$ref": "#/$defs/IntegerJson"
                }
              },
              "required": ["move"],
              "additionalProperties": false
            }
          },
          "required": ["seq", "seat", "intent"],
          "additionalProperties": false
        }
      },
      "required": ["ok", "event"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "code": {
          "type": "string",
          "enum": [
            "MATCH_FINISHED",
            "NOT_YOUR_TURN",
            "MOVE_NOT_ALLOWED",
            "UNKNOWN_MOVE",
            "INVALID_ARGS",
            "INVALID_MOVE",
            "GAME_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "gameCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
        }
      },
      "required": ["ok", "code", "message"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "IntegerJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntegerJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IntegerJson"
          }
        }
      ]
    }
  },
  "title": "HostMoveOutcome"
}
