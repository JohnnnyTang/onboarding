{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PROTOCOL_VERSION",
            "BAD_MESSAGE",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "MATCH_NOT_FOUND",
            "MATCH_NOT_ACTIVE",
            "MATCH_FINISHED",
            "NOT_YOUR_TURN",
            "MOVE_NOT_ALLOWED",
            "UNKNOWN_MOVE",
            "INVALID_ARGS",
            "INVALID_MOVE",
            "GAME_ERROR",
            "RATE_LIMITED",
            "SEAT_TAKEN_OVER",
            "VALIDATION_FAILED",
            "NOT_FOUND",
            "CONFLICT",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["path", "message"],
            "additionalProperties": false
          }
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "required": ["error"],
  "additionalProperties": false,
  "title": "HttpError"
}
