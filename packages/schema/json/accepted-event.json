{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "intent": {
      "type": "object",
      "properties": {
        "move": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "$ref": "#/$defs/IntegerJson"
        }
      },
      "required": ["move"],
      "additionalProperties": false
    }
  },
  "required": ["seq", "seat", "intent"],
  "additionalProperties": false,
  "$defs": {
    "IntegerJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntegerJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IntegerJson"
          }
        }
      ]
    }
  },
  "title": "AcceptedEvent"
}
