{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "presence"
    },
    "seats": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": ["t", "seats"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "seat": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "guest": {
          "type": "boolean"
        }
      },
      "required": ["seat", "name", "connected", "guest"],
      "additionalProperties": false
    }
  },
  "title": "PresenceMessage"
}
