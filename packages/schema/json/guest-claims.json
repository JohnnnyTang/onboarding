{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matchId": {
      "$ref": "#/$defs/__schema0"
    },
    "seat": {
      "$ref": "#/$defs/__schema1"
    },
    "iss": {
      "$ref": "#/$defs/__schema2"
    },
    "aud": {
      "$ref": "#/$defs/__schema3"
    },
    "sub": {
      "$ref": "#/$defs/__schema0"
    },
    "iat": {
      "$ref": "#/$defs/__schema4"
    },
    "exp": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": ["matchId", "seat", "iss", "aud", "sub", "iat", "exp"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "__schema2": {
      "type": "string",
      "const": "bgp:guest"
    },
    "__schema3": {
      "type": "string",
      "const": "bgp:api"
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "title": "GuestClaims"
}
