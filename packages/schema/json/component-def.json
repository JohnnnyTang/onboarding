        "corner_radius_mm": {
          "type": "number",
          "minimum": 0
        },
        "front": {
          "$ref": "#/$defs/__schema6"
        },
        "back": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["id", "kind", "size_mm", "front", "back"],
