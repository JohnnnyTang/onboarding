          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema1"
        },
        "mass_g": {
          "$ref": "#/$defs/__schema2"
        },
        "material": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
