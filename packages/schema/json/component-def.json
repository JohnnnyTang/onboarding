        "size_mm": {
          "$ref": "#/$defs/__schema4"
        },
        "thickness_mm": {
          "$ref": "#/$defs/__schema5"
        },
        "front": {
          "$ref": "#/$defs/__schema6"
        },
        "back": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": ["id", "kind", "shape", "size_mm", "front"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema1"
        },
        "mass_g": {
          "$ref": "#/$defs/__schema2"
        },
        "material": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
          "$ref": "#/$defs/__schema8"
        },
        "sides": {
          "$ref": "#/$defs/__schema9"
        },
        "size_mm": {
          "$ref": "#/$defs/__schema5"
        },
        "faces": {
          "$ref": "#/$defs/__schema10"
        },
        "color": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": ["id", "kind", "sides", "size_mm"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema1"
        },
        "mass_g": {
          "$ref": "#/$defs/__schema2"
        },
        "material": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
          "type": "string",
          "const": "board"
        },
        "size_mm": {
          "$ref": "#/$defs/__schema4"
        },
        "image": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": ["id", "kind", "size_mm", "image"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
