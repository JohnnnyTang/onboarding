        }
      },
      "required": ["id", "kind", "image"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema1"
        },
        "mass_g": {
          "$ref": "#/$defs/__schema2"
        },
        "material": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
          "type": "string",
          "const": "token"
        },
        "shape": {
          "type": "string",
          "enum": ["circle", "square", "rect", "hex"]
