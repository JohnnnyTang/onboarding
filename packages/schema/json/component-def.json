        "name": {
          "$ref": "#/$defs/__schema1"
        },
        "mass_g": {
          "$ref": "#/$defs/__schema2"
        },
        "material": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
          "type": "string",
          "const": "piece"
        },
        "size_mm": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema5"
            },
            {
              "$ref": "#/$defs/__schema5"
            },
            {
              "$ref": "#/$defs/__schema5"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "image": {
          "$ref": "#/$defs/__schema6"
