{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "def": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "zone": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "face": {
            "type": "string",
            "enum": ["up", "down"]
          },
          "shuffle": {
            "type": "boolean"
          }
        },
        "required": ["def", "zone"],
        "additionalProperties": false
      }
    }
  },
  "required": ["instances"],
  "additionalProperties": false,
  "title": "SandboxSetup"
}
