{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "error"
    },
    "code": {
      "type": "string",
      "enum": [
        "PROTOCOL_VERSION",
        "BAD_MESSAGE",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "MATCH_NOT_FOUND",
        "MATCH_NOT_ACTIVE",
        "MATCH_FINISHED",
        "NOT_YOUR_TURN",
        "MOVE_NOT_ALLOWED",
        "UNKNOWN_MOVE",
        "INVALID_ARGS",
        "INVALID_MOVE",
        "GAME_ERROR",
        "RATE_LIMITED",
        "SEAT_TAKEN_OVER",
        "VALIDATION_FAILED",
        "NOT_FOUND",
        "CONFLICT",
        "INTERNAL"
      ]
    },
    "message": {
      "type": "string"
    },
    "fatal": {
      "type": "boolean"
    }
  },
  "required": ["t", "code", "message", "fatal"],
  "additionalProperties": false,
  "title": "ErrorMessage"
}
