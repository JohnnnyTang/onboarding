{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": ["items"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "def": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "zone": {
            "$ref": "#/$defs/__schema1"
          },
          "index": {
            "minimum": 0,
            "$ref": "#/$defs/__schema2"
          },
          "pos_mm": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/__schema2"
              },
              {
                "$ref": "#/$defs/__schema2"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "rotation_deg": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359,
            "$ref": "#/$defs/__schema2"
          },
          "face": {
            "type": "string",
            "enum": ["up", "down"]
          },
          "value": {
            "exclusiveMinimum": 0,
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": ["id", "def", "zone", "index", "rotation_deg", "face"],
        "additionalProperties": false
      }
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "title": "SandboxState"
}
