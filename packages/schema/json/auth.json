{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["user", "guest"]
    },
    "token": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["kind", "token"],
  "additionalProperties": false,
  "title": "Auth"
}
