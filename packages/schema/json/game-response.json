{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "unlisted"]
    }
  },
  "required": ["id", "slug", "name", "visibility"],
  "additionalProperties": false,
  "title": "GameResponse"
}
