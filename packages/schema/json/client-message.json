{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "hello"
        },
        "protocol": {
          "type": "number",
          "const": 1
        },
        "matchId": {
          "$ref": "#/$defs/__schema0"
        },
        "auth": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["user", "guest"]
            },
            "token": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": ["kind", "token"],
          "additionalProperties": false
        },
        "lastSeq": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["t", "protocol", "matchId", "auth"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "move"
        },
        "clientSeq": {
          "$ref": "#/$defs/__schema1"
        },
        "intent": {
          "type": "object",
          "properties": {
            "move": {
              "$ref": "#/$defs/__schema0"
            },
            "args": {
              "$ref": "#/$defs/IntegerJson"
            }
          },
          "required": ["move"],
          "additionalProperties": false
        }
      },
      "required": ["t", "clientSeq", "intent"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "resync"
        }
      },
      "required": ["t"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "ephemeral"
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "drag"
                },
                "item": {
                  "$ref": "#/$defs/__schema0"
                },
                "pos_mm": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": ["kind", "item", "pos_mm"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "pointer"
                },
                "pos_mm": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": ["kind", "pos_mm"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["t", "data"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "chat"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": ["t", "text"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "ping"
        },
        "ts": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["t", "ts"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "minimum": 0,
      "$ref": "#/$defs/__schema2"
    },
    "__schema2": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema2"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "IntegerJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntegerJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IntegerJson"
          }
        }
      ]
    }
  },
  "title": "ClientMessage"
}
