{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string"
    },
    "connected": {
      "type": "boolean"
    },
    "guest": {
      "type": "boolean"
    }
  },
  "required": ["seat", "name", "connected", "guest"],
  "additionalProperties": false,
  "title": "SeatInfo"
}
