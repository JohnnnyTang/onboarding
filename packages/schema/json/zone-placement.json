{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "layout": {
      "$ref": "#/$defs/__schema1"
    },
    "label": {
      "$ref": "#/$defs/__schema2"
    },
    "grid": {
      "$ref": "#/$defs/__schema3"
    },
    "rect_mm": {
      "$ref": "#/$defs/__schema6"
    },
    "owner": {
      "$ref": "#/$defs/__schema7"
    },
    "droppable": {
      "$ref": "#/$defs/__schema8"
    }
  },
  "required": ["id", "layout", "rect_mm"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string",
      "enum": ["stack", "row", "fan", "grid", "free"]
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "cols": {
          "$ref": "#/$defs/__schema4"
        },
        "rows": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": ["cols", "rows"],
      "additionalProperties": false
    },
    "__schema4": {
      "exclusiveMinimum": 0,
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/__schema5"
        },
        "y": {
          "$ref": "#/$defs/__schema5"
        },
        "w": {
          "$ref": "#/$defs/__schema4"
        },
        "h": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "__schema8": {
      "type": "boolean"
    }
  },
  "title": "ZonePlacement"
}
