{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "name": {
      "$ref": "#/$defs/__schema2"
    },
    "size_mm": {
      "$ref": "#/$defs/__schema3"
    },
    "background": {
      "$ref": "#/$defs/__schema4"
    },
    "fields": {
      "$ref": "#/$defs/__schema5"
    },
    "back": {
      "$ref": "#/$defs/__schema12"
    },
    "data": {
      "$ref": "#/$defs/__schema13"
    },
    "generated": {
      "$ref": "#/$defs/__schema15"
    }
  },
  "required": ["id", "name", "size_mm", "background", "fields", "back", "data", "generated"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "maxLength": 40,
      "$ref": "#/$defs/__schema1"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema4": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "__schema5": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema7"
            },
            "label": {
              "$ref": "#/$defs/__schema8"
            },
            "rect_mm": {
              "$ref": "#/$defs/__schema9"
            },
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 2000
            },
            "size_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 200
            },
            "color": {
              "$ref": "#/$defs/__schema4"
            },
            "font": {
              "type": "string",
              "enum": [
                "inter",
                "atkinson-hyperlegible",
                "source-serif-4",
                "cinzel",
                "oswald",
                "jetbrains-mono",
                "sans-serif",
                "serif",
                "monospace"
              ]
            },
            "bold": {
              "type": "boolean"
            },
            "align": {
              "type": "string",
              "enum": ["left", "center", "right"]
            },
            "valign": {
              "type": "string",
              "enum": ["top", "middle", "bottom"]
            }
          },
          "required": [
            "id",
            "label",
            "rect_mm",
            "kind",
            "text",
            "size_mm",
            "color",
            "font",
            "bold",
            "align",
            "valign"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema7"
            },
            "label": {
              "$ref": "#/$defs/__schema8"
            },
            "rect_mm": {
              "$ref": "#/$defs/__schema9"
            },
            "kind": {
              "type": "string",
              "const": "image"
            },
            "image": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fit": {
              "type": "string",
              "enum": ["contain", "cover"]
            }
          },
          "required": ["id", "label", "rect_mm", "kind", "image", "fit"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema7"
            },
            "label": {
              "$ref": "#/$defs/__schema8"
            },
            "rect_mm": {
              "$ref": "#/$defs/__schema9"
            },
            "kind": {
              "type": "string",
              "const": "box"
            },
            "color": {
              "$ref": "#/$defs/__schema4"
            },
            "radius_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 500
            }
          },
          "required": ["id", "label", "rect_mm", "kind", "color", "radius_mm"],
          "additionalProperties": false
        }
      ]
    },
    "__schema7": {
      "maxLength": 40,
      "$ref": "#/$defs/__schema1"
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/__schema10"
        },
        "y": {
          "$ref": "#/$defs/__schema10"
        },
        "w": {
          "$ref": "#/$defs/__schema11"
        },
        "h": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "__schema11": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "__schema12": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema1"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema14"
          }
        },
        "idColumn": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema14"
            },
            {
              "type": "null"
            }
          ]
        },
        "nameColumn": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema14"
            },
            {
              "type": "null"
            }
          ]
        },
        "countColumn": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema14"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["source", "columns", "idColumn", "nameColumn", "countColumn"],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema15": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "title": "CardTemplate"
}
