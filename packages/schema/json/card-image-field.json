{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "rect_mm": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/__schema0"
        },
        "y": {
          "$ref": "#/$defs/__schema0"
        },
        "w": {
          "$ref": "#/$defs/__schema1"
        },
        "h": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "const": "image"
    },
    "image": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fit": {
      "type": "string",
      "enum": ["contain", "cover"]
    }
  },
  "required": ["id", "label", "rect_mm", "kind", "image", "fit"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "__schema1": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    }
  },
  "title": "CardImageField"
}
