        "h": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },
    "__schema21": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        {
          "type": "string",
          "const": "each"
        }
      ]
    },
    "__schema22": {
      "type": "string",
      "enum": ["public", "owner"]
