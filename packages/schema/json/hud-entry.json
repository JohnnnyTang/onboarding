{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/__schema0"
    },
    "handCount": {
      "minimum": 0,
      "$ref": "#/$defs/__schema0"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": ["seat", "active"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "title": "HudEntry"
}
