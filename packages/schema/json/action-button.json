{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "label": {
      "$ref": "#/$defs/__schema1"
    },
    "enabled": {
      "$ref": "#/$defs/__schema2"
    },
    "intent": {
      "$ref": "#/$defs/__schema3"
    },
    "hint": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": ["id", "label", "enabled"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "boolean"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "move": {
          "$ref": "#/$defs/__schema0"
        },
        "args": {
          "$ref": "#/$defs/IntegerJson"
        }
      },
      "required": ["move"],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string"
    },
    "IntegerJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntegerJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IntegerJson"
          }
        }
      ]
    }
  },
  "title": "ActionButton"
}
