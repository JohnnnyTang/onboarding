{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "match": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "enum": ["lobby", "active", "finished", "abandoned"]
        },
        "versionId": {
          "$ref": "#/$defs/__schema0"
        },
        "buildHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seats": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": ["id", "status", "versionId", "buildHash", "seats"],
      "additionalProperties": false
    },
    "invites": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    }
  },
  "required": ["match", "invites"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "seat": {
          "$ref": "#/$defs/__schema2"
        },
        "name": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "guest": {
          "type": "boolean"
        }
      },
      "required": ["seat", "name", "connected", "guest"],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "seat": {
          "$ref": "#/$defs/__schema2"
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["seat", "url"],
      "additionalProperties": false
    }
  },
  "title": "CreateMatchResponse"
}
