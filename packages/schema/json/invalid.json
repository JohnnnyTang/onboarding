{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "invalid": {
      "type": "boolean",
      "const": true
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "message": {
      "type": "string"
    }
  },
  "required": ["invalid", "code", "message"],
  "additionalProperties": false,
  "title": "Invalid"
}
