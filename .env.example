# Copy to .env. The dev launcher reads this file before starting services.
PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://bgp:bgp@localhost:5432/bgp
TEST_DATABASE_URL=postgres://bgp:bgp@localhost:5432/bgp_test
OIDC_ISSUER=http://localhost:8080/realms/bgp
OIDC_AUDIENCE=bgp-api
# Generate locally: node -p "require('node:crypto').randomBytes(32).toString('base64')"
GUEST_TOKEN_SECRET=
BLOB_DRIVER=fs
BLOB_FS_DIR=./.data/blobs
BUNDLE_CACHE_DIR=./.data/bundle-cache
RULES_HOST_PROCESSES=1
RULES_CALL_TIMEOUT_MS=1000
RULES_MEMORY_MB=64
RULES_SANDBOX=quickjs
LOG_LEVEL=info
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_OIDC_ISSUER=http://localhost:8080/realms/bgp
VITE_OIDC_CLIENT_ID=bgp-web
