{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["scripts/build-rules-host.ts"],
  "globalPassThroughEnv": [
    "npm_execpath",
    "BGP_PROPERTY_RUNS",
    "BGP_PRNG_DRAWS",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "OIDC_ISSUER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
