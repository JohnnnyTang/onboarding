{
  "name": "board-game-platform",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:table": "pnpm --filter @bgp/table-2d... build && vite",
    "build:table-dev": "pnpm --filter @bgp/table-2d... build && vite build",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "biome check . && tsx scripts/check-boundaries.ts",
    "format": "biome format --write .",
    "test": "turbo run test && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @bgp/server db:generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:wasm": "tsx scripts/check-wasm-inventory.ts",
    "json-schema": "pnpm --filter @bgp/schema json-schema",
    "perf": "tsx scripts/pending-task.ts T20 PERF-01"
  },
  "devDependencies": {
    "@bgp/schema": "workspace:*",
    "@bgp/table-2d": "workspace:*",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.183.1",
    "pixi.js": "8.6.6",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "5.0.5"
  }
}
